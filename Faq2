cat /sys/module/amdgpu/parameters/ppfeaturemask


for card in /sys/class/drm/card*/device/hwmon/hwmon*; do
    echo "Настройка $card..."
    # 1. Пытаемся включить ручной режим (1)
    echo 1 | sudo tee "$card/pwm1_enable" || echo "Ошибка включения режима на $card"
    # 2. Пытаемся выставить скорость (150)
    echo 150 | sudo tee "$card/pwm1" || echo "Ошибка установки скорости на $card"
done


sudo apt install python3-pip
sudo pip3 install amdgpu-fan --break-system-packages
sudo amdgpu-fan




# Включаем ручное управление для всех карт сразу
for i in /sys/class/drm/card*/device/hwmon/hwmon*/pwm1_enable; do echo 1 | sudo tee $i; done

# Ставим скорость (150 из 255 — это примерно 60% оборотов)
for i in /sys/class/drm/card*/device/hwmon/hwmon*/pwm1; do echo 150 | sudo tee $i; done


hashcat -b --optimized-kernel-enable=0


ppfeaturemask (команда cat /proc/cmdline).
