From 191ed074de660284b4bea6855eaaa426bb0e070e Mon Sep 17 00:00:00 2001
From: "copilot-swe-agent[bot]" <198982749+Copilot@users.noreply.github.com>
Date: Mon, 16 Feb 2026 15:20:26 +0000
Subject: [PATCH] Fix BSD build failures by removing unnecessary git dependency

The NetBSD, FreeBSD, OpenBSD, and DragonflyBSD builds were failing due to package dependency conflicts when trying to install git. Since the code is already checked out by GitHub Actions before the VM starts, git is not needed during the build process.

This fix removes git from the package installation list for all BSD variants, which resolves the NetBSD pcre2 dependency conflict and prevents similar issues on other BSD systems.

Co-authored-by: komyaka <34284729+komyaka@users.noreply.github.com>
---
 .github/workflows/build.yml | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index 38029ec97..9ed4f68cb 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -133,7 +133,7 @@ jobs:
           envs: SHARED
           prepare: |
             pkg update
-            pkg install -y git gcc gmake gsed python3 rust llvm
+            pkg install -y gcc gmake gsed python3 rust llvm
           run: |
             gmake ENABLE_LTO=0 CC=clang CXX=clang++
 
@@ -144,7 +144,7 @@ jobs:
           usesh: true
           envs: SHARED
           prepare: |
-            pkg_add git gcc%11 gmake gsed llvm%19
+            pkg_add gcc%11 gmake gsed llvm%19
           run: |
             export TERM=xterm
             gmake ENABLE_LTO=0 CC=clang CXX=clang++
@@ -157,7 +157,7 @@ jobs:
           envs: SHARED
           prepare: |
             export PATH="/usr/sbin:$PATH"
-            pkg_add git gcc14 gmake gsed python313 llvm libiconv clang
+            pkg_add gcc14 gmake gsed python313 llvm libiconv clang
           run: |
             export PATH="/usr/pkg/gcc14/bin:$PATH"
             export TERM=xterm
@@ -171,7 +171,7 @@ jobs:
           envs: SHARED
           prepare: |
             pkg update
-            pkg install -y git gcc gmake gsed python3 llvm
+            pkg install -y gcc gmake gsed python3 llvm
           run: |
             export TERM=xterm
             gmake ENABLE_LTO=0 CC=clang CXX=clang++
